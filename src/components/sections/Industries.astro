---
import Container from "../shared/Container.astro";

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

interface SectorItem {
  id: string;
  title: string;
  description: string;
  icon: string;
}

const sectors: SectorItem[] = [
  {
    id: "residential",
    title: "Residensial & Hunian",
    description:
      "Kusen pintu aluminium anti-rayap, jendela geser kedap suara, partisi minimalis, serta kitchen set tahan air untuk hunian modern keluarga.",
    icon: "home",
  },
  {
    id: "office",
    title: "Perkantoran & Korporasi",
    description:
      "Sekat partisi kaca tempered frameless, pintu floor hinge otomatis, dan ruang meeting kedap suara untuk menciptakan atmosfer kerja profesional.",
    icon: "building",
  },
  {
    id: "commercial",
    title: "Ruko & Area Komersial",
    description:
      "Kusen kokoh tahan benturan, etalase kaca display pamer, dan folding door aluminium berdaya tahan tinggi untuk operasional bisnis.",
    icon: "store",
  },
  {
    id: "culinary",
    title: "Restoran, Kafe & F&B",
    description:
      "Pintu lipat kaca bukaan lebar untuk konsep semi-outdoor, sekat transparan estetik, dan jendela servis pesanan yang elegan dan fungsional.",
    icon: "cafe",
  },
  {
    id: "healthcare",
    title: "Fasilitas Kesehatan & Medis",
    description:
      "Pintu geser higienis, partisi kaca kedap debu, dan material aluminium anti-korosi yang mudah disterilisasi sesuai standar kebersihan klinik.",
    icon: "medical",
  },
  {
    id: "hospitality",
    title: "Perhotelan & Villa Mewah",
    description:
      "Pintu geser balkon panorama kedap suara, shower box kaca tempered, dan aksen arsitektural aluminium mewah tahan cuaca lembap.",
    icon: "hotel",
  },
];
---

<section id="sektor" class={`relative reveal ${className}`}>
  <Container>
    <!-- Header: Tag & Main headline -->
    <div class="mb-10 md:mb-14">
      <span class="text-primary font-bold text-sm md:text-base tracking-wide flex items-center gap-2 mb-2">
        Sektor yang Kami Layani
      </span>
      <h2 class="text-heading-1 text-3xl sm:text-4xl md:text-[2.75rem] font-bold leading-[1.2]">
        Solusi Kustom Aluminium & Kaca <br class="hidden sm:inline" />
        <span class="text-primary">untuk Berbagai Sektor</span>
      </h2>
    </div>

    <!-- Cards Carousel Area -->
    <div class="relative w-full">
      <div
        id="industry-carousel"
        class="flex overflow-x-auto snap-x snap-mandatory gap-5 sm:gap-6 hide-scroll-bar pb-6 pt-2 -mx-4 px-4 sm:mx-0 sm:px-0 scroll-smooth"
      >
        {sectors.map((item, index) => (
          <div
            data-sector-card
            class={`industry-card group snap-start shrink-0 w-[84vw] sm:w-[calc(50%-0.75rem)] lg:w-[calc(25%-1.125rem)] rounded-[2rem] p-7 sm:p-8 flex flex-col justify-between bg-box-bg border border-box-border/80 shadow-[0_4px_20px_rgb(0,0,0,0.03)] hover:shadow-xl hover:shadow-primary/5 hover:border-primary/40 hover:-translate-y-1.5 transition-all duration-300 cursor-pointer ${
              index === 0 ? "is-active" : ""
            }`}
          >
          
            <div>
              <!-- Single Clean, Prominent Icon Container -->
              <div class="w-16 h-16 rounded-2xl bg-blue-50/90 dark:bg-slate-800 text-primary flex items-center justify-center transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:scale-105 group-hover:shadow-lg group-hover:shadow-primary/20">
                {item.icon === "home" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                  </svg>
                )}
                {item.icon === "building" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M6 21V4.5A1.5 1.5 0 017.5 3h9a1.5 1.5 0 011.5 1.5V21M9 7.5h1.5m3 0H15M9 11.25h1.5m3 0H15M9 15h1.5m3 0H15" />
                  </svg>
                )}
                {item.icon === "store" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.25m15 0H21.75M3 10.5h18l-1.5-6H4.5L3 10.5zM3 10.5a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0M4.5 21V12M19.5 21V12" />
                  </svg>
                )}
                {item.icon === "cafe" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 2v3M10 2v3M14 2v3" />
                  </svg>
                )}
                {item.icon === "medical" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    <rect x="3" y="3" width="18" height="18" rx="4" stroke-width="2" />
                  </svg>
                )}
                {item.icon === "hotel" && (
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 7v14M21 7v14M3 11h18M7 11V7a2 2 0 012-2h6a2 2 0 012 2v4M10 15h4v6h-4v-6z" />
                  </svg>
                )}
              </div>

              <!-- Title -->
              <h3 class="text-xl sm:text-2xl font-bold text-heading-1 mt-7 mb-3 group-hover:text-primary transition-colors duration-200">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-heading-3 text-sm sm:text-base leading-relaxed">
                {item.description}
              </p>
            </div>

            <!-- Bottom Flow: Action Link to Contact (#cta) -->
            <a
              href="#cta"
              class="pt-6 mt-6 border-t border-box-border/60 flex items-center justify-between text-xs sm:text-sm font-semibold text-slate-400 group-hover:text-primary transition-colors duration-200"
            >
              <span>Hubungi Kami</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  /* Hide scrollbars for carousel */
  .hide-scroll-bar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scroll-bar::-webkit-scrollbar {
    display: none;
  }

  .industry-card {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .industry-card.is-active {
    border-color: #1d4ed8;
    box-shadow: 0 12px 30px -8px rgba(29, 78, 216, 0.12);
  }

  :global(.dark) .industry-card.is-active {
    border-color: #3b82f6;
    box-shadow: 0 12px 30px -8px rgba(59, 130, 246, 0.2);
  }
</style>

<script>
  function setupIndustriesCards() {
    const carousel = document.getElementById("industry-carousel");
    const cards = document.querySelectorAll("[data-sector-card]");

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let isDragging = false;

    // Toggle active state on card click (only when not dragging)
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        if (!isDragging) {
          cards.forEach((c) => c.classList.remove("is-active"));
          card.classList.add("is-active");
        }
      });
    });

    // Smooth drag-to-scroll support for desktop
    if (carousel) {
      carousel.style.cursor = "grab";

      carousel.addEventListener("mousedown", (e) => {
        isDown = true;
        isDragging = false;
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
        carousel.style.cursor = "grabbing";
        carousel.style.scrollBehavior = "auto";
        carousel.style.scrollSnapType = "none";
        carousel.style.userSelect = "none";
      });

      const stopIndustryDrag = () => {
        if (!isDown) return;
        isDown = false;
        carousel.style.cursor = "grab";
        carousel.style.scrollBehavior = "smooth";
        carousel.style.scrollSnapType = "x mandatory";
        carousel.style.removeProperty("user-select");
        setTimeout(() => {
          isDragging = false;
        }, 60);
      };

      carousel.addEventListener("mouseleave", stopIndustryDrag);
      window.addEventListener("mouseup", stopIndustryDrag);

      carousel.addEventListener("mousemove", (e) => {
        if (!isDown) return;
        const x = e.pageX - carousel.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 5) {
          isDragging = true;
        }
        carousel.scrollLeft = scrollLeft - walk;
      });

      // Prevent accidental link or button triggers during drag
      carousel.addEventListener(
        "click",
        (e) => {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupIndustriesCards);
  } else {
    setupIndustriesCards();
  }
</script>
