---
import Container from "../shared/Container.astro";
import { Image, getImage } from "astro:assets";
import { products } from "../../utils/data.ts";

export interface Props {
    className?: string;
}

const { className } = Astro.props;

const productItems = await Promise.all(
    products.map(async (product) => ({
        ...product,
        modalImage: product.image
            ? await getImage({
                  src: product.image,
                  width: 800,
                  format: "webp",
                  quality: 70,
              })
            : null,
    }))
);
---

<section id="products" class={`relative reveal ${className}`}>
    <Container>
        <!-- Header: title left, description right -->
        <div class="flex flex-col items-center text-center gap-4 mb-10">
            <h2 class="text-4xl md:text-5xl font-bold text-heading-1 leading-tight">
                Beberapa Hasil 
                <span class="text-primary-text"> Pengerjaan Kami</span>
            </h2>
            <p class="text-heading-3 max-w-2xl text-sm md:text-base leading-relaxed">
                Jelajahi berbagai model dan desain aluminium premium untuk kebutuhan hunian Anda. Kualitas unggul, desain elegan, dan pengerjaan presisi. Untuk model yang tidak ada di sini bisa cek ke Instagram kami @agungjaya_aluminiumm.
            </p>
        </div>

        <!-- Horizontal scrollable grid blocks -->
        <div
            class="relative w-full mt-10"
            role="region"
            aria-roledescription="carousel"
            aria-label="Galeri hasil pengerjaan"
        >
            <div
                id="product-carousel"
                class="carousel-track flex overflow-x-auto snap-x snap-mandatory gap-6 hide-scroll-bar pb-8 -mx-4 px-4 sm:mx-0 sm:px-0"
                tabindex="0"
                role="group"
                aria-label="Slide produk"
            >
                {productItems.map((product, index) => (
                    <div
                        class="product-item snap-start shrink-0 w-[85vw] sm:w-[calc(50%-0.75rem)] lg:w-[calc(25%-1.125rem)] select-none"
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${index + 1} dari ${productItems.length}`}
                    >
                        <div class="group flex flex-col bg-white dark:bg-slate-800 rounded-[2rem] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none border border-slate-100 dark:border-slate-800 hover:shadow-xl transition-all duration-500 hover:-translate-y-1 h-full">
                            
                            <!-- Product Image Header -->
                            <div class="relative w-full aspect-[4/5] bg-slate-100 dark:bg-slate-700 overflow-hidden select-none">
                                {product.image ? (
                                    <Image
                                        src={product.image}
                                        alt={product.title}
                                        widths={[240, 320, 400, 560, 640]}
                                        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 85vw"
                                        format="webp"
                                        quality={70}
                                        loading="lazy"
                                        decoding="async"
                                        draggable="false"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none select-none"
                                    />
                                ) : (
                                    <div class="w-full h-full flex flex-col items-center justify-center text-slate-600 dark:text-slate-300">
                                        <svg class="w-8 h-8 mb-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span class="text-sm font-medium">Gambar Tidak Tersedia</span>
                                    </div>
                                )}
                            </div>

                            <!-- Product Info Body -->
                            <div class="p-5 flex-1 flex flex-col">
                                <h3 class="text-heading-1 font-bold text-lg mb-1 group-hover:text-primary-text transition-colors">
                                    {product.title}
                                </h3>
                                <p class="text-heading-3 text-sm line-clamp-2">
                                    {product.description}
                                </p>
                                <div class="mt-auto pt-4 flex">
                                    <button 
                                        type="button"
                                        class="btn-detail text-primary-text text-sm font-semibold flex items-center gap-1 hover:gap-2 transition-all rounded-md"
                                        data-title={product.title}
                                        data-desc={product.description}
                                        data-img={product.modalImage?.src ?? ''}
                                        data-alt={product.title}
                                    >
                                        Lihat Detail
                                        <svg class="w-4 h-4 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                                    </button>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                ))}
            </div>

        <!-- Navigation Elements -->
        {productItems.length > 4 && (
            <div class="flex items-center justify-center gap-6 mt-4">
                <!-- Prev Button -->
                <button id="carousel-prev" type="button" class="flex w-12 h-12 rounded-full border border-slate-200 dark:border-slate-800 items-center justify-center text-slate-500 hover:text-primary-text hover:border-primary transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:-translate-x-1" aria-label="Slide sebelumnya">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <!-- Next Button -->
                <button id="carousel-next" type="button" class="flex w-12 h-12 rounded-full border border-slate-200 dark:border-slate-800 items-center justify-center text-slate-500 hover:text-primary-text hover:border-primary transition-all hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:translate-x-1" aria-label="Slide berikutnya">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        )}

        <p class="sr-only" role="status" aria-live="polite" data-product-status>Slide 1 dari {productItems.length}</p>
        </div>
    </Container>

    <!-- Product Detail Modal -->
    <dialog
        id="product-modal"
        {...({ closedby: "any" } as any)}
        aria-labelledby="modal-title"
        class="backdrop:bg-slate-900/60 p-0 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-800 w-[90vw] max-w-lg bg-white dark:bg-slate-900 custom-dialog"
    >
        <div class="relative flex flex-col max-h-[85vh]">
            <button id="modal-close" type="button" aria-label="Tutup detail produk" class="absolute top-4 right-4 z-10 w-9 h-9 flex items-center justify-center bg-black/40 hover:bg-black/60 text-white rounded-full transition-colors backdrop-blur-md">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <div class="w-full aspect-[4/5] sm:h-[45vh] sm:aspect-auto bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0">
                <img id="modal-img" alt="Detail produk" width="400" height="500" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                <svg id="modal-img-placeholder" class="w-12 h-12 text-slate-500 dark:text-slate-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div class="p-6 md:p-8 overflow-y-auto">
                <h3 id="modal-title" class="text-2xl font-bold text-heading-1 mb-4"></h3>
                <p id="modal-desc" class="text-heading-3 leading-relaxed text-sm md:text-base"></p>
                <form method="dialog" class="mt-8 flex justify-end w-full">
                    <button type="submit" class="px-6 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-heading-2 rounded-full font-medium transition-colors">Tutup</button>
                </form>
            </div>
        </div>
    </dialog>

    <style>
        .hide-scroll-bar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        .hide-scroll-bar::-webkit-scrollbar {
            display: none;
        }

        #product-carousel img {
            -webkit-user-drag: none;
            -khtml-user-drag: none;
            -moz-user-drag: none;
            -o-user-drag: none;
            user-drag: none;
        }

        .custom-dialog {
            opacity: 0;
            transform: scale(0.95);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease,
                display 0.3s,
                overlay 0.3s;
            transition-behavior: allow-discrete;
        }

        .custom-dialog[open] {
            opacity: 1;
            transform: scale(1);
        }

        @starting-style {
            .custom-dialog[open] {
                opacity: 0;
                transform: scale(0.95);
            }
        }

        .custom-dialog::backdrop {
            opacity: 0;
            transition:
                opacity 0.3s ease,
                display 0.3s,
                overlay 0.3s;
            transition-behavior: allow-discrete;
        }

        .custom-dialog[open]::backdrop {
            opacity: 1;
        }

        @starting-style {
            .custom-dialog[open]::backdrop {
                opacity: 0;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .custom-dialog,
            .custom-dialog::backdrop {
                transition: none;
            }
        }
    </style>

    <script>
        function setupProductsCarousel() {
            const carousel = document.getElementById('product-carousel') as HTMLElement | null;
            const items = Array.from(carousel?.querySelectorAll<HTMLElement>('.product-item') ?? []);
            const btnPrev = document.getElementById('carousel-prev') as HTMLButtonElement | null;
            const btnNext = document.getElementById('carousel-next') as HTMLButtonElement | null;
            const status = document.querySelector('[data-product-status]') as HTMLElement | null;

            if (!carousel || items.length === 0) return;

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const behavior = (): ScrollBehavior => (reduceMotion.matches ? 'auto' : 'smooth');

            const getGap = () => {
                const gap = Number.parseFloat(getComputedStyle(carousel).columnGap || '0');
                return Number.isFinite(gap) ? gap : 0;
            };

            const getStep = () => {
                const width = items[0]?.getBoundingClientRect().width ?? carousel.clientWidth;
                return width + getGap();
            };

            const getMaxScroll = () => Math.max(0, carousel.scrollWidth - carousel.clientWidth);
            const atStart = () => carousel.scrollLeft <= 4;
            const atEnd = () => carousel.scrollLeft >= getMaxScroll() - 4;

            const getIndex = () => {
                const step = getStep();
                if (!step) return 0;
                return Math.max(0, Math.min(items.length - 1, Math.round(carousel.scrollLeft / step)));
            };

            const scrollToIndex = (index: number) => {
                carousel.scrollTo({ left: index * getStep(), behavior: behavior() });
            };

            const announce = () => {
                if (!status) return;
                const step = getStep();
                const first = getIndex();
                const visible = step ? Math.max(1, Math.round(carousel.clientWidth / step)) : 1;
                const last = Math.min(items.length, first + visible);
                status.textContent =
                    last > first + 1
                        ? `Menampilkan slide ${first + 1} sampai ${last} dari ${items.length}`
                        : `Slide ${first + 1} dari ${items.length}`;
            };

            let settleTimer = 0;
            const onSettled = () => announce();

            if ('onscrollend' in window) {
                carousel.addEventListener('scrollend', onSettled);
            } else {
                carousel.addEventListener('scroll', () => {
                    window.clearTimeout(settleTimer);
                    settleTimer = window.setTimeout(onSettled, 150);
                });
            }

            btnPrev?.addEventListener('click', () => {
                if (atStart()) {
                    carousel.scrollTo({ left: getMaxScroll(), behavior: behavior() });
                    return;
                }
                scrollToIndex(Math.max(0, getIndex() - 1));
            });

            btnNext?.addEventListener('click', () => {
                if (atEnd()) {
                    carousel.scrollTo({ left: 0, behavior: behavior() });
                    return;
                }
                scrollToIndex(Math.min(items.length - 1, getIndex() + 1));
            });

            // Drag to slide functionality for desktop
            let isDown = false;
            let startX = 0;
            let scrollLeft = 0;
            let isDragging = false;

            carousel.style.cursor = 'grab';

            carousel.addEventListener('mousedown', (e) => {
                isDown = true;
                isDragging = false;
                startX = e.pageX - carousel.offsetLeft;
                scrollLeft = carousel.scrollLeft;
                carousel.style.cursor = 'grabbing';
                carousel.style.scrollBehavior = 'auto';
                carousel.style.scrollSnapType = 'none';
                carousel.style.userSelect = 'none';
            });

            const stopProductDrag = () => {
                if (!isDown) return;
                isDown = false;
                carousel.style.cursor = 'grab';
                carousel.style.scrollBehavior = '';
                carousel.style.scrollSnapType = 'x mandatory';
                carousel.style.removeProperty('user-select');
                window.setTimeout(() => {
                    isDragging = false;
                }, 60);
            };

            carousel.addEventListener('mouseleave', stopProductDrag);
            window.addEventListener('mouseup', stopProductDrag);

            carousel.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                const x = e.pageX - carousel.offsetLeft;
                const walk = (x - startX) * 1.5;
                if (Math.abs(walk) > 5) {
                    isDragging = true;
                }
                carousel.scrollLeft = scrollLeft - walk;
            });

            // Prevent accidental click actions (such as opening modal) when dragging
            carousel.addEventListener(
                'click',
                (e) => {
                    if (isDragging) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                },
                true
            );

            announce();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', setupProductsCarousel);
        } else {
            setupProductsCarousel();
        }

        // Modal Logic
        const modal = document.getElementById('product-modal') as HTMLDialogElement | null;
        const detailBtns = document.querySelectorAll<HTMLButtonElement>('.btn-detail');
        const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
        const modalPlaceholder = document.getElementById('modal-img-placeholder');
        const modalTitle = document.getElementById('modal-title');
        const modalDesc = document.getElementById('modal-desc');
        const modalClose = document.getElementById('modal-close');

        if (modal) {
            detailBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const title = btn.getAttribute('data-title') ?? '';
                    const desc = btn.getAttribute('data-desc') ?? '';
                    const img = btn.getAttribute('data-img') ?? '';
                    const alt = btn.getAttribute('data-alt') ?? title;

                    if (modalTitle) modalTitle.textContent = title;
                    if (modalDesc) modalDesc.textContent = desc;

                    if (modalImg) {
                        if (img) {
                            modalImg.src = img;
                            modalImg.alt = alt;
                            modalImg.classList.remove('hidden');
                            modalPlaceholder?.classList.add('hidden');
                        } else {
                            modalImg.removeAttribute('src');
                            modalImg.alt = '';
                            modalImg.classList.add('hidden');
                            modalPlaceholder?.classList.remove('hidden');
                        }
                    }

                    modal.showModal();
                });
            });

            modalClose?.addEventListener('click', () => modal.close());

            // Light-dismiss fallback for browsers without <dialog closedby>
            if (!('closedBy' in HTMLDialogElement.prototype)) {
                let pressedOutside = false;
                const isOutside = (event: PointerEvent) => {
                    const rect = modal.getBoundingClientRect();
                    return (
                        event.clientX < rect.left ||
                        event.clientX > rect.right ||
                        event.clientY < rect.top ||
                        event.clientY > rect.bottom
                    );
                };

                modal.addEventListener('pointerdown', (event) => {
                    pressedOutside = isOutside(event);
                });
                modal.addEventListener('pointerup', (event) => {
                    if (pressedOutside && isOutside(event)) modal.close();
                });
            }
        }
    </script>
</section>
